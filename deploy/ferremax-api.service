[Unit]
Description=FerreMax API (FastAPI + uvicorn)
After=network.target

[Service]
Type=simple
User=ferremax
Group=ferremax
WorkingDirectory=/opt/ferremax/app/backend
EnvironmentFile=/etc/ferremax.env
ExecStart=/opt/ferremax/app/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
